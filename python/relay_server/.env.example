# ZMQ
ZMQ_HOST=127.0.0.1
ZMQ_PORT=5555
ZMQ_RECEIVE_HWM=1
ZMQ_CONFLATE=true
ZMQ_LINGER_MS=0
ZMQ_ERROR_BACKOFF_SECONDS=1.0

# PostgreSQL + TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simcore
DB_USER=postgres
DB_PASSWORD=postgres
DB_WRITE_TIMEOUT_SECONDS=0.5
DB_ERROR_BACKOFF_SECONDS=1.0

# DB 저장 여부 (true/false)
DB_ENABLED=false

# Server
HOST=0.0.0.0
PORT=8000
WS_SEND_TIMEOUT_SECONDS=0.1
