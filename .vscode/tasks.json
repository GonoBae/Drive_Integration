{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure C++ host",
      "type": "shell",
      "command": "cmake",
      "args": ["--preset", "release"],
      "options": {
        "cwd": "${workspaceFolder}/cpp/host"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: build C++ host",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "options": {
        "cwd": "${workspaceFolder}/cpp/host"
      },
      "dependsOn": "CMake: configure C++ host",
      "problemMatcher": ["$gcc", "$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "CTest: C++ host",
      "type": "shell",
      "command": "ctest",
      "args": ["--preset", "release"],
      "options": {
        "cwd": "${workspaceFolder}/cpp/host"
      },
      "problemMatcher": []
    }
  ]
}
