      "includePath": [
        "${workspaceFolder}/cpp/host/src",
        "${workspaceFolder}/cpp/host/build/vcpkg_installed/x64-windows/include",
        "${workspaceFolder}/cpp/host/build"
      ],
      "cppStandard": "c++20"
    }
  ],
  "version": 4
}
